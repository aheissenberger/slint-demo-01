import { Palette } from "std-widgets.slint";

export global Theme {
    out property <length> space_1: 4px;
    out property <length> space_2: 8px;
    out property <length> space_3: 12px;
    out property <length> space_4: 16px;
    out property <length> space_5: 20px;
    out property <length> space_6: 24px;
    out property <length> space_8: 32px;

    // Slint's Fluent style resolves this from the current system color scheme.
    out property <bool> dark_color_scheme: Palette.color-scheme == ColorScheme.dark;
    out property <color> background: dark_color_scheme ? #1c1c1c : #f7f7f7;
    out property <color> panel: dark_color_scheme ? #292929 : #ffffff;
    out property <color> panel_alt: dark_color_scheme ? #333333 : #f5f5f5;
    out property <color> panel_subtle: dark_color_scheme ? #242424 : #fbfbfb;
    out property <color> panel_tint: dark_color_scheme ? #203445 : #f3f8fd;
    out property <color> panel_disabled: dark_color_scheme ? #242424 : #f5f5f5;
    out property <color> border: dark_color_scheme ? #4c4c4c : #e1e1e1;
    out property <color> border_strong: dark_color_scheme ? #777777 : #c7c7c7;

    out property <color> text_primary: dark_color_scheme ? #f5f5f5 : #1a1a1a;
    out property <color> text_secondary: dark_color_scheme ? #c7c7c7 : #4a4a4a;
    out property <color> text_disabled: dark_color_scheme ? #8f8f8f : #8a8a8a;
    out property <color> text_placeholder: dark_color_scheme ? #ababab : #616161;

    out property <color> accent: dark_color_scheme ? #60cdff : #0f6cbd;
    out property <color> accent_hover: dark_color_scheme ? #8edbff : #115ea3;
    out property <color> accent_pressed: dark_color_scheme ? #3bb9ed : #0c3b6f;
    out property <color> accent_foreground: dark_color_scheme ? #002b45 : #ffffff;
    out property <color> destructive_surface: dark_color_scheme ? #592b2f : #f3d9d9;
    out property <color> destructive_surface_hover: dark_color_scheme ? #70373c : #f1d3d3;
    out property <color> destructive_surface_pressed: dark_color_scheme ? #853f45 : #ebc2c2;

    out property <color> focus: dark_color_scheme ? #ffffff : #005fb8;
    out property <color> focus_ring: dark_color_scheme ? #ffffff : #005fb8;
    out property <color> success: dark_color_scheme ? #6ccb5f : #107c10;
    out property <color> warning: dark_color_scheme ? #f0b849 : #9a6700;
    out property <color> error: dark_color_scheme ? #ff99a4 : #d13438;

    out property <color> shadow: dark_color_scheme ? rgba(0, 0, 0, 0.42) : rgba(0, 0, 0, 0.12);
    // Modal backdrop behind an elevated dialog surface (Fluent 2 smoke layer).
    out property <color> scrim: rgba(0, 0, 0, 0.4);
    // Matches Fluent 2 ControlCornerRadius (buttons, text fields).
    out property <length> radius_1: 4px;
    // Matches Fluent 2 OverlayCornerRadius (cards, dialogs, flyouts).
    out property <length> radius_2: 8px;
    out property <length> radius_3: 8px;

    out property <length> control_height: 32px;
    out property <length> field_height: 36px;
    out property <length> field_label_height: 20px;
    out property <length> app_header_height: 64px;
    out property <length> window_preferred_height: 560px;
    out property <length> window_min_height: 520px;
    out property <length> page_gutter: 32px;
    out property <length> form_content_width: 440px;
    out property <length> button_min_width: 96px;
    // Caps the width of the `AboutSlint` "Made with Slint" badge so its
    // logo image does not scale up to fill the whole About dialog width.
    out property <length> about_logo_max_width: 192px;
    out property <float> disabled_opacity: 0.5;
    out property <length> border_width: 1px;
    out property <length> border_width_none: 0px;
    out property <length> focus_border_width: 2px;
    out property <length> surface_shadow_blur: 8px;
    out property <length> surface_shadow_offset_y: 2px;
    out property <length> dialog_shadow_blur: 16px;
    out property <length> dialog_shadow_offset_y: 8px;
    out property <duration> motion_fast: 100ms;
    out property <length> title_size: 24px;
    out property <length> subtitle_size: 18px;
    out property <length> body_size: 14px;
    out property <length> caption_size: 12px;
    out property <length> title_line_height: 32px;
    out property <length> subtitle_line_height: 24px;
    out property <length> body_line_height: 20px;
    out property <length> caption_line_height: 16px;
    out property <string> font_family: "Segoe UI Variable";

    out property <int> title_weight: 600;
    out property <int> body_weight: 400;
    out property <int> strong_weight: 600;
}
