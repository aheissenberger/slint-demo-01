export global Theme {
    out property <length> space_1: 4px;
    out property <length> space_2: 8px;
    out property <length> space_3: 12px;
    out property <length> space_4: 16px;
    out property <length> space_5: 20px;
    out property <length> space_6: 24px;
    out property <length> space_8: 32px;

    out property <color> background: #f7f7f7;
    out property <color> panel: #ffffff;
    out property <color> panel_alt: #f5f5f5;
    out property <color> panel_subtle: #fbfbfb;
    out property <color> border: #e1e1e1;
    out property <color> border_strong: #c7c7c7;

    out property <color> text_primary: #1a1a1a;
    out property <color> text_secondary: #4a4a4a;
    out property <color> text_disabled: #8a8a8a;

    out property <color> accent: #0f6cbd;
    out property <color> accent_hover: #115ea3;
    out property <color> accent_pressed: #0c3b6f;
    out property <color> accent_foreground: #ffffff;
    out property <color> destructive_surface: #f3d9d9;
    out property <color> destructive_surface_hover: #f1d3d3;
    out property <color> destructive_surface_pressed: #ebc2c2;

    out property <color> focus: #005fb8;
    out property <color> success: #107c10;
    out property <color> warning: #9a6700;
    out property <color> error: #d13438;

    out property <color> shadow: rgba(0, 0, 0, 0.12);
    // Matches Fluent 2 ControlCornerRadius (buttons, text fields).
    out property <length> radius_1: 4px;
    // Matches Fluent 2 OverlayCornerRadius (cards, dialogs, flyouts).
    out property <length> radius_2: 8px;
    out property <length> radius_3: 8px;

    out property <length> control_height: 32px;
    out property <length> field_height: 36px;
    out property <length> field_label_height: 20px;
    out property <length> title_size: 24px;
    out property <length> subtitle_size: 18px;
    out property <length> body_size: 14px;
    out property <length> caption_size: 12px;
    out property <string> font_family: "Segoe UI";

    out property <int> title_weight: 600;
    out property <int> body_weight: 400;
    out property <int> strong_weight: 600;
}
