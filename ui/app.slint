import { FluentButton } from "./components/fluent-button.slint";
import { FluentTextField } from "./components/fluent-text-field.slint";
import { AboutDialog } from "./screens/about-dialog.slint";
import { SettingsDialog } from "./screens/settings-dialog.slint";
import { Theme } from "./theme/theme.slint";

export component MainWindow inherits Window {
    in property <string> status: @tr("bereit");
    in property <string> app-version: "0.1.0";
    in property <bool> submit-enabled: false;
    in property <bool> cancel-enabled: false;
    in property <bool> retry-enabled: false;
    in property <int> progress: -1;
    in property <bool> error-visible: false;
    in property <bool> error-critical-visible: false;
    in property <string> error-title: "";
    in property <string> error-message: "";
    in property <string> error-detail: "";
    in property <string> input-validation-message: "";
    in property <string> note-title-validation-message: "";
    in property <string> note-body-validation-message: "";
    in property <string> task-summary: "";
    in property <string> data-summary: "";
    in property <string> last-backup-path: "";
    in property <bool> note-save-enabled: false;
    in property <bool> note-selected: false;
    in property <int> notes-count: 0;
    in-out property <string> note-title: "";
    in-out property <string> note-body: "";
    in-out property <string> note-slot-0-id: "";
    in-out property <string> note-slot-0-title: "";
    in-out property <string> note-slot-0-body: "";
    in-out property <string> note-slot-1-id: "";
    in-out property <string> note-slot-1-title: "";
    in-out property <string> note-slot-1-body: "";
    in-out property <string> note-slot-2-id: "";
    in-out property <string> note-slot-2-title: "";
    in-out property <string> note-slot-2-body: "";
    in-out property <string> note-slot-3-id: "";
    in-out property <string> note-slot-3-title: "";
    in-out property <string> note-slot-3-body: "";
    in-out property <string> note-slot-4-id: "";
    in-out property <string> note-slot-4-title: "";
    in-out property <string> note-slot-4-body: "";
    in-out property <string> input-value: "";
    in-out property <string> selected-file: "";
    in-out property <string> theme-mode: "system";
    out property <bool> about-visible: about-popup.is-open;
    out property <bool> settings-visible: settings-popup.is-open;
    out property <bool> critical-error-visible: critical-error-popup.is-open;
    callback submit(string);
    callback input-changed(string);
    callback pick-file();
    callback show-native-file-picker();
    callback reset();
    callback cancel();
    callback retry-last-task();
    callback dismiss-error();
    callback create-data-backup();
    callback reset-user-data();
    callback new-note();
    callback save-note();
    callback archive-note();
    callback delete-note();
    callback select-note(string);
    callback note-title-changed(string);
    callback note-body-changed(string);
    callback about-visibility-changed(bool);
    callback settings-visibility-changed(bool);
    callback theme-mode-changed(string);

    function apply-theme-mode() {
        Theme.color_scheme = root.theme-mode == "light"
            ? ColorScheme.light
            : root.theme-mode == "dark"
                ? ColorScheme.dark
                : ColorScheme.unknown;
    }

    // agent-id: "error.dialog"
    // agent-role: "alertdialog"
    // agent-actions: ""
    critical-error-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.scrim;
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: Theme.critical_dialog_width;
            height: Theme.critical_dialog_height;
            border-radius: Theme.radius_2;
            border-width: Theme.border_width;
            border-color: Theme.border;
            background: Theme.panel;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.surface_shadow_blur;
            drop-shadow-offset-y: Theme.surface_shadow_offset_y;

            VerticalLayout {
                x: Theme.space_6;
                y: Theme.space_6;
                width: parent.width - Theme.space_6 * 2;
                height: parent.height - Theme.space_6 * 2;
                spacing: Theme.space_4;
                alignment: start;

                Text {
                    text: root.error-title == "" ? @tr("Kritischer Fehler") : root.error-title;
                    color: Theme.text_primary;
                    font-size: Theme.title_size;
                    font-family: Theme.font_family;
                    font-weight: Theme.title_weight;
                    height: Theme.title_line_height;
                }

                Text {
                    width: parent.width;
                    height: Theme.body_line_height * 3;
                    text: root.error-message;
                    color: Theme.text_primary;
                    font-size: Theme.body_size;
                    font-family: Theme.font_family;
                    wrap: word-wrap;
                    accessible-label: @tr("Fehlermeldung");
                }

                Text {
                    width: parent.width;
                    height: Theme.caption_line_height * 2;
                    text: root.error-detail;
                    color: Theme.text_secondary;
                    font-size: Theme.caption_size;
                    font-family: Theme.font_family;
                    wrap: word-wrap;
                    accessible-label: @tr("Fehlerdiagnose");
                }

                HorizontalLayout {
                    width: parent.width;
                    height: Theme.control_height;
                    alignment: end;

                    critical-error-close-button := FluentButton {
                        label: @tr("Schließen");
                        agent-id: "error.dialog.close";
                        agent-role: "button";
                        agent-actions: "click,focus";
                        clicked => {
                            root.dismiss-error();
                        }
                    }
                }
            }
        }
    }

    init => {
        root.apply-theme-mode();
    }

    changed theme-mode => {
        root.apply-theme-mode();
    }

    public function show-about() {
        about-popup.show();
    }

    public function hide-about() {
        about-popup.close();
    }

    public function show-settings() {
        settings-popup.show();
    }

    public function hide-settings() {
        settings-popup.close();
    }

    public function show-critical-error() {
        critical-error-popup.show();
    }

    public function hide-critical-error() {
        critical-error-popup.close();
    }

    public function focus-control(element-id: string) {
        if (element-id == "main.input") {
            input-field.focus-control();
        } else if (element-id == "main.file-picker") {
            file-picker.focus-control();
        } else if (element-id == "main.reset") {
            reset-button.focus-control();
        } else if (element-id == "main.submit") {
            submit-button.focus-control();
        } else if (element-id == "main.cancel") {
            cancel-button.focus-control();
        } else if (element-id == "notes.new") {
            new-note-button.focus-control();
        } else if (element-id == "notes.title") {
            note-title-field.focus-control();
        } else if (element-id == "notes.body") {
            note-body-field.focus-control();
        } else if (element-id == "notes.save") {
            save-note-button.focus-control();
        } else if (element-id == "notes.archive") {
            archive-note-button.focus-control();
        } else if (element-id == "notes.delete") {
            delete-note-button.focus-control();
        }
    }

    title: @tr("Slint Agent Desktop");
    preferred-width: Theme.shell_sidebar_width + Theme.shell_content_width + Theme.page_gutter * 2 + Theme.space_6;
    preferred-height: Theme.window_preferred_height + Theme.space_8;
    min-width: Theme.shell_sidebar_width + Theme.shell_content_width + Theme.space_6;
    min-height: Theme.window_min_height;

    MenuBar {
        Menu {
            title: @tr("Datei");
            // agent-id: "file.settings"
            // agent-role: "menuitem"
            // agent-actions: "click"
            MenuItem {
                title: @tr("Einstellungen");
                activated => {
                    root.settings-visibility-changed(true);
                }
            }
        }

        Menu {
            title: @tr("Hilfe");
            // agent-id: "help.about"
            // agent-role: "menuitem"
            // agent-actions: "click"
            // `MenuItem` has no `agent-id` property; this marker keeps the
            // agent-api coverage check (scripts/agent-api-check) in sync with
            // crates/agent-api's "help.about" element.
            MenuItem {
                title: @tr("Über");
                activated => {
                    root.about-visibility-changed(true);
                }
            }
        }
    }

    // agent-id: "settings.dialog"
    // agent-role: "dialog"
    // agent-actions: ""
    settings-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.scrim;
        }

        SettingsDialog {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            theme-mode <=> root.theme-mode;
            data-summary: root.data-summary;
            last-backup-path: root.last-backup-path;
            theme-mode-changed(mode) => {
                root.theme-mode-changed(mode);
            }
            create-data-backup => {
                root.create-data-backup();
            }
            reset-user-data => {
                root.reset-user-data();
            }
            close-requested => {
                root.settings-visibility-changed(false);
            }
        }
    }

    // agent-id: "about.dialog"
    // agent-role: "dialog"
    // agent-actions: ""
    // `PopupWindow` has no `agent-id` property; this marker keeps the
    // agent-api coverage check (scripts/agent-api-check) in sync with
    // crates/agent-api's "about.dialog" element.
    about-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;
        init => {
            about-dialog.focus-close();
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.scrim;
        }

        about-dialog := AboutDialog {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            app-version: root.app-version;
            close-requested => {
                root.about-visibility-changed(false);
            }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: Theme.background;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: Theme.app_header_height;
        background: Theme.panel;
    }

    Rectangle {
        x: Theme.page_gutter;
        y: Theme.space_6;
        width: Theme.space_1;
        height: Theme.space_8;
        background: Theme.accent;
        border-radius: Theme.radius_1;
    }

    Text {
        x: Theme.page_gutter + Theme.space_4;
        y: Theme.space_4;
        width: root.width - Theme.page_gutter * 2;
        height: Theme.subtitle_line_height;
        text: @tr("Slint Agent Desktop");
        color: Theme.text_primary;
        font-size: Theme.subtitle_size;
        font-family: Theme.font_family;
        font-weight: Theme.title_weight;
        vertical-alignment: center;
    }

    Rectangle {
        y: Theme.app_header_height - Theme.border_width;
        width: root.width;
        height: Theme.border_width;
        background: Theme.border;
    }

    HorizontalLayout {
        x: Theme.page_gutter;
        y: Theme.app_header_height + Theme.space_6;
        width: root.width - Theme.page_gutter * 2;
        height: root.height - Theme.app_header_height - Theme.space_6 * 2;
        spacing: Theme.space_6;
        alignment: start;

        Rectangle {
            width: Theme.shell_sidebar_width;
            height: parent.height;
            border-radius: Theme.radius_2;
            border-width: Theme.border_width;
            border-color: Theme.border;
            background: Theme.panel;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.surface_shadow_blur;
            drop-shadow-offset-y: Theme.surface_shadow_offset_y;

            VerticalLayout {
                x: Theme.space_4;
                y: Theme.space_4;
                width: parent.width - Theme.space_4 * 2;
                height: parent.height - Theme.space_4 * 2;
                spacing: Theme.space_3;
                alignment: start;

                Text {
                    text: @tr("Notizen");
                    color: Theme.text_primary;
                    font-size: Theme.subtitle_size;
                    font-family: Theme.font_family;
                    font-weight: Theme.strong_weight;
                    height: Theme.subtitle_line_height;
                }

                // agent-id: "notes.list"
                // agent-role: "list"
                // agent-actions: "get_value"
                Text {
                    text: root.notes-count == 0 ? @tr("Noch keine Notizen") : @tr("{} aktive Notizen", root.notes-count);
                    color: Theme.text_secondary;
                    font-size: Theme.caption_size;
                    font-family: Theme.font_family;
                    accessible-label: @tr("Notizliste");
                    height: Theme.caption_line_height;
                }

                new-note-button := FluentButton {
                    width: parent.width;
                    label: @tr("Neue Notiz");
                    agent-id: "notes.new";
                    agent-role: "button";
                    agent-actions: "click,focus";
                    clicked => {
                        root.new-note();
                    }
                }

                FluentButton {
                    width: parent.width;
                    label: root.note-slot-0-id == "" ? @tr("Leerer Notizplatz") : root.note-slot-0-title;
                    disabled: root.note-slot-0-id == "";
                    agent-id: "notes.item.0";
                    agent-role: "button";
                    agent-actions: "click";
                    clicked => { root.select-note(root.note-slot-0-id); }
                }

                FluentButton {
                    width: parent.width;
                    label: root.note-slot-1-id == "" ? @tr("Leerer Notizplatz") : root.note-slot-1-title;
                    disabled: root.note-slot-1-id == "";
                    agent-id: "notes.item.1";
                    agent-role: "button";
                    agent-actions: "click";
                    clicked => { root.select-note(root.note-slot-1-id); }
                }

                FluentButton {
                    width: parent.width;
                    label: root.note-slot-2-id == "" ? @tr("Leerer Notizplatz") : root.note-slot-2-title;
                    disabled: root.note-slot-2-id == "";
                    agent-id: "notes.item.2";
                    agent-role: "button";
                    agent-actions: "click";
                    clicked => { root.select-note(root.note-slot-2-id); }
                }

                FluentButton {
                    width: parent.width;
                    label: root.note-slot-3-id == "" ? @tr("Leerer Notizplatz") : root.note-slot-3-title;
                    disabled: root.note-slot-3-id == "";
                    agent-id: "notes.item.3";
                    agent-role: "button";
                    agent-actions: "click";
                    clicked => { root.select-note(root.note-slot-3-id); }
                }

                FluentButton {
                    width: parent.width;
                    label: root.note-slot-4-id == "" ? @tr("Leerer Notizplatz") : root.note-slot-4-title;
                    disabled: root.note-slot-4-id == "";
                    agent-id: "notes.item.4";
                    agent-role: "button";
                    agent-actions: "click";
                    clicked => { root.select-note(root.note-slot-4-id); }
                }
            }
        }

        Rectangle {
            width: root.width - Theme.page_gutter * 2 - Theme.shell_sidebar_width - Theme.space_6;
            height: parent.height;
            border-radius: Theme.radius_2;
            border-width: Theme.border_width;
            border-color: Theme.border;
            background: Theme.panel;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.surface_shadow_blur;
            drop-shadow-offset-y: Theme.surface_shadow_offset_y;

            VerticalLayout {
                x: Theme.space_6;
                y: Theme.space_6;
                width: parent.width - Theme.space_6 * 2;
                height: parent.height - Theme.space_6 * 2;
                spacing: Theme.space_2;
                alignment: start;

                Text {
                    text: root.note-selected ? @tr("Notiz bearbeiten") : @tr("Neue Notiz");
                    color: Theme.text_primary;
                    font-size: Theme.title_size;
                    font-family: Theme.font_family;
                    font-weight: Theme.title_weight;
                    height: Theme.title_line_height;
                }

                Text {
                    text: @tr("Schreiben, speichern und archivieren Sie lokale Notizen.");
                    color: Theme.text_secondary;
                    font-size: Theme.body_size;
                    font-family: Theme.font_family;
                    height: Theme.body_line_height;
                }

                note-title-field := FluentTextField {
                    width: parent.width;
                    label: @tr("Titel");
                    placeholder: @tr("Titel der Notiz");
                    value <=> root.note-title;
                    agent-id: "notes.title";
                    agent-role: "textbox";
                    agent-actions: "get_value,set_value,focus";
                    label-for-accessibility: @tr("Notiztitel");
                    edited(value) => {
                        root.note-title-changed(value);
                    }
                }

                if (root.note-title-validation-message != "") : Text {
                    width: parent.width;
                    text: root.note-title-validation-message;
                    color: Theme.error;
                    font-size: Theme.caption_size;
                    font-family: Theme.font_family;
                    height: Theme.caption_line_height;
                    accessible-label: @tr("Validierung des Notiztitels");
                }

                note-body-field := FluentTextField {
                    width: parent.width;
                    label: @tr("Inhalt");
                    placeholder: @tr("Inhalt der Notiz");
                    value <=> root.note-body;
                    agent-id: "notes.body";
                    agent-role: "textbox";
                    agent-actions: "get_value,set_value,focus";
                    label-for-accessibility: @tr("Notizinhalt");
                    edited(value) => {
                        root.note-body-changed(value);
                    }
                }

                if (root.note-body-validation-message != "") : Text {
                    width: parent.width;
                    text: root.note-body-validation-message;
                    color: Theme.error;
                    font-size: Theme.caption_size;
                    font-family: Theme.font_family;
                    height: Theme.caption_line_height;
                    accessible-label: @tr("Validierung des Notizinhalts");
                }

                HorizontalLayout {
                    width: parent.width;
                    spacing: Theme.space_3;
                    alignment: end;
                    height: Theme.control_height;

                    delete-note-button := FluentButton {
                        label: @tr("Löschen");
                        destructive: true;
                        disabled: !root.note-selected;
                        agent-id: "notes.delete";
                        agent-role: "button";
                        agent-actions: "click,focus";
                        clicked => { root.delete-note(); }
                    }

                    archive-note-button := FluentButton {
                        label: @tr("Archivieren");
                        disabled: !root.note-selected;
                        agent-id: "notes.archive";
                        agent-role: "button";
                        agent-actions: "click,focus";
                        clicked => { root.archive-note(); }
                    }

                    save-note-button := FluentButton {
                        label: @tr("Speichern");
                        primary: true;
                        disabled: !root.note-save-enabled;
                        agent-id: "notes.save";
                        agent-role: "button";
                        agent-actions: "click,focus";
                        clicked => { root.save-note(); }
                    }
                }

                Rectangle {
                    width: parent.width;
                    height: Theme.border_width;
                    background: Theme.border;
                }

                Text {
                    text: @tr("Agent-Demo");
                    color: Theme.text_primary;
                    font-size: Theme.subtitle_size;
                    font-family: Theme.font_family;
                    font-weight: Theme.strong_weight;
                    height: Theme.subtitle_line_height;
                }

                // agent-id: "main.status"
                // agent-role: "status"
                // agent-actions: ""
                Text {
                    text: @tr("Status: {}", root.status);
                    color: Theme.text_secondary;
                    font-size: Theme.caption_size;
                    font-family: Theme.font_family;
                    accessible-label: @tr("Anwendungsstatus");
                    height: Theme.caption_line_height;
                }

                // agent-id: "main.error"
                // agent-role: "alert"
                // agent-actions: "get_value"
                if (root.error-visible && !root.error-critical-visible) : Rectangle {
                    width: parent.width;
                    height: Theme.inline_error_height;
                    border-radius: Theme.radius_1;
                    border-width: Theme.border_width;
                    border-color: Theme.error;
                    background: Theme.panel;

                    VerticalLayout {
                        x: Theme.space_3;
                        y: Theme.space_3;
                        width: parent.width - Theme.space_3 * 2;
                        height: parent.height - Theme.space_3 * 2;
                        spacing: Theme.space_2;

                        Text {
                            text: root.error-title;
                            color: Theme.error;
                            font-size: Theme.body_size;
                            font-family: Theme.font_family;
                            font-weight: Theme.strong_weight;
                            height: Theme.body_line_height;
                        }

                        Text {
                            text: root.error-message;
                            color: Theme.text_primary;
                            font-size: Theme.caption_size;
                            font-family: Theme.font_family;
                            height: Theme.caption_line_height;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            width: parent.width;
                            height: Theme.control_height;
                            spacing: Theme.space_2;
                            alignment: end;

                            retry-button := FluentButton {
                                label: @tr("Erneut versuchen");
                                disabled: !root.retry-enabled;
                                agent-id: "main.retry";
                                agent-role: "button";
                                agent-actions: "click,focus";
                                clicked => { root.retry-last-task(); }
                            }

                            dismiss-error-button := FluentButton {
                                label: @tr("Hinweis schließen");
                                agent-id: "main.error.dismiss";
                                agent-role: "button";
                                agent-actions: "click,focus";
                                clicked => { root.dismiss-error(); }
                            }
                        }
                    }
                }

                if (root.progress >= 0) : Text {
                    text: @tr("Fortschritt: {}%", root.progress);
                    color: Theme.text_secondary;
                    font-size: Theme.caption_size;
                    font-family: Theme.font_family;
                    accessible-label: @tr("Fortschritt des Vorgangs");
                    height: Theme.caption_line_height;
                }

                // agent-id: "main.tasks"
                // agent-role: "status"
                // agent-actions: "get_value"
                Text {
                    width: parent.width;
                    text: root.task-summary == "" ? @tr("Keine Hintergrundvorgänge") : root.task-summary;
                    color: Theme.text_secondary;
                    font-size: Theme.caption_size;
                    font-family: Theme.font_family;
                    accessible-label: @tr("Hintergrundvorgänge");
                    height: Theme.caption_line_height;
                }

                input-field := FluentTextField {
                    width: parent.width;
                    label: @tr("Wert");
                    placeholder: @tr("Wert eingeben");
                    value <=> root.input-value;
                    agent-id: "main.input";
                    agent-role: "textbox";
                    agent-actions: "get_value,set_value,focus";
                    label-for-accessibility: @tr("Haupteingabe");
                    edited(value) => {
                        root.input-changed(value);
                    }
                }

                if (root.input-validation-message != "") : Text {
                    width: parent.width;
                    text: root.input-validation-message;
                    color: Theme.error;
                    font-size: Theme.caption_size;
                    font-family: Theme.font_family;
                    height: Theme.caption_line_height;
                    accessible-label: @tr("Validierung der Haupteingabe");
                }

                file-picker := FluentButton {
                    label: @tr("Datei auswählen");
                    agent-id: "main.file-picker";
                    agent-role: "button";
                    agent-actions: "click,get_value,set_value,focus";
                    clicked => {
                        root.pick-file();
                    }
                }

                // agent-id: "main.selected-file"
                // agent-role: "status"
                // agent-actions: "get_value"
                Text {
                    width: parent.width;
                    height: Theme.body_line_height * 2;
                    text: root.selected-file == "" ? @tr("Keine Datei ausgewählt") : root.selected-file;
                    color: root.selected-file == "" ? Theme.text_secondary : Theme.text_primary;
                    font-size: Theme.body_size;
                    font-family: Theme.font_family;
                    wrap: word-wrap;
                    accessible-label: @tr("Ausgewählter Dateipfad");
                }

                HorizontalLayout {
                    width: parent.width;
                    spacing: Theme.space_3;
                    alignment: end;
                    height: Theme.control_height;

                    reset-button := FluentButton {
                        label: @tr("Zurücksetzen");
                        agent-id: "main.reset";
                        agent-role: "button";
                        agent-actions: "click,focus";
                        clicked => {
                            root.input-value = "";
                            root.reset();
                        }
                    }

                    submit-button := FluentButton {
                        label: @tr("Senden");
                        primary: true;
                        disabled: !root.submit-enabled;
                        agent-id: "main.submit";
                        agent-role: "button";
                        agent-actions: "click,focus";
                        clicked => {
                            root.submit(root.input-value);
                        }
                    }

                    cancel-button := FluentButton {
                        label: @tr("Abbrechen");
                        disabled: !root.cancel-enabled;
                        agent-id: "main.cancel";
                        agent-role: "button";
                        agent-actions: "click,focus";
                        clicked => {
                            root.cancel();
                        }
                    }
                }
            }
        }
    }
}
