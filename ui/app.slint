import { FluentButton } from "./components/fluent-button.slint";
import { FluentTextField } from "./components/fluent-text-field.slint";
import { AboutDialog } from "./screens/about-dialog.slint";
import { SettingsDialog } from "./screens/settings-dialog.slint";
import { Theme } from "./theme/theme.slint";

export component MainWindow inherits Window {
    in property <string> status: @tr("bereit");
    in property <string> app-version: "0.1.0";
    in property <bool> submit-enabled: false;
    in property <bool> cancel-enabled: false;
    in property <int> progress: -1;
    in-out property <string> input-value: "";
    in-out property <string> selected-file: "";
    in-out property <string> theme-mode: "system";
    out property <bool> about-visible: about-popup.is-open;
    out property <bool> settings-visible: settings-popup.is-open;
    callback submit(string);
    callback input-changed(string);
    callback pick-file();
    callback show-native-file-picker();
    callback reset();
    callback cancel();
    callback about-visibility-changed(bool);
    callback settings-visibility-changed(bool);
    callback theme-mode-changed(string);

    function apply-theme-mode() {
        Theme.color_scheme = root.theme-mode == "light"
            ? ColorScheme.light
            : root.theme-mode == "dark"
                ? ColorScheme.dark
                : ColorScheme.unknown;
    }

    init => {
        root.apply-theme-mode();
    }

    changed theme-mode => {
        root.apply-theme-mode();
    }

    public function show-about() {
        about-popup.show();
    }

    public function hide-about() {
        about-popup.close();
    }

    public function show-settings() {
        settings-popup.show();
    }

    public function hide-settings() {
        settings-popup.close();
    }

    public function focus-control(element-id: string) {
        if (element-id == "main.input") {
            input-field.focus-control();
        } else if (element-id == "main.file-picker") {
            file-picker.focus-control();
        } else if (element-id == "main.reset") {
            reset-button.focus-control();
        } else if (element-id == "main.submit") {
            submit-button.focus-control();
        } else if (element-id == "main.cancel") {
            cancel-button.focus-control();
        }
    }

    title: @tr("Slint Agent Desktop");
    preferred-width: 740px;
    preferred-height: Theme.window_preferred_height;
    min-width: 520px;
    min-height: Theme.window_min_height;

    MenuBar {
        Menu {
            title: @tr("Datei");
            // agent-id: "file.settings"
            // agent-role: "menuitem"
            // agent-actions: "click"
            MenuItem {
                title: @tr("Einstellungen");
                activated => {
                    root.settings-visibility-changed(true);
                }
            }
        }

        Menu {
            title: @tr("Hilfe");
            // agent-id: "help.about"
            // agent-role: "menuitem"
            // agent-actions: "click"
            // `MenuItem` has no `agent-id` property; this marker keeps the
            // agent-api coverage check (scripts/agent-api-check) in sync with
            // crates/agent-api's "help.about" element.
            MenuItem {
                title: @tr("Über");
                activated => {
                    root.about-visibility-changed(true);
                }
            }
        }
    }

    // agent-id: "settings.dialog"
    // agent-role: "dialog"
    // agent-actions: ""
    settings-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.scrim;
        }

        SettingsDialog {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            theme-mode <=> root.theme-mode;
            theme-mode-changed(mode) => {
                root.theme-mode-changed(mode);
            }
            close-requested => {
                root.settings-visibility-changed(false);
            }
        }
    }

    // agent-id: "about.dialog"
    // agent-role: "dialog"
    // agent-actions: ""
    // `PopupWindow` has no `agent-id` property; this marker keeps the
    // agent-api coverage check (scripts/agent-api-check) in sync with
    // crates/agent-api's "about.dialog" element.
    about-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;
        init => {
            about-dialog.focus-close();
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.scrim;
        }

        about-dialog := AboutDialog {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            app-version: root.app-version;
            close-requested => {
                root.about-visibility-changed(false);
            }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: Theme.background;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: Theme.app_header_height;
        background: Theme.panel;
    }

    Rectangle {
        x: Theme.page_gutter;
        y: Theme.space_6;
        width: Theme.space_1;
        height: Theme.space_8;
        background: Theme.accent;
        border-radius: Theme.radius_1;
    }

    Text {
        x: Theme.page_gutter + Theme.space_4;
        y: Theme.space_4;
        width: root.width - Theme.page_gutter * 2;
        height: Theme.subtitle_line_height;
        text: @tr("Slint Agent Desktop");
        color: Theme.text_primary;
        font-size: Theme.subtitle_size;
        font-family: Theme.font_family;
        font-weight: Theme.title_weight;
        vertical-alignment: center;
    }

    Rectangle {
        y: Theme.app_header_height - Theme.border_width;
        width: root.width;
        height: Theme.border_width;
        background: Theme.border;
    }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: Theme.app_header_height + Theme.space_6;
        width: Theme.form_content_width + Theme.space_6 * 2;
        height: root.height - Theme.app_header_height - Theme.space_6 * 2;
        border-radius: Theme.radius_2;
        border-width: Theme.border_width;
        border-color: Theme.border;
        background: Theme.panel;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: Theme.surface_shadow_blur;
        drop-shadow-offset-y: Theme.surface_shadow_offset_y;

        VerticalLayout {
            x: Theme.space_6;
            y: Theme.space_6;
            width: parent.width - Theme.space_6 * 2;
            height: parent.height - Theme.space_6 * 2;
            spacing: Theme.space_4;
            alignment: start;

            Text {
                text: @tr("Wert senden");
                color: Theme.text_primary;
                font-size: Theme.title_size;
                font-family: Theme.font_family;
                font-weight: Theme.title_weight;
                height: Theme.title_line_height;
            }

            Text {
                text: @tr("Geben Sie einen Wert ein, um ihn an den Agenten zu senden.");
                color: Theme.text_secondary;
                font-size: Theme.body_size;
                font-family: Theme.font_family;
                height: Theme.body_line_height;
            }

            // agent-id: "main.status"
            // agent-role: "status"
            // agent-actions: ""
            // Plain `Text` has no `agent-id` property; this marker keeps the
            // agent-api coverage check (scripts/agent-api-check) in sync with
            // crates/agent-api's "main.status" element.
            Text {
                text: @tr("Status: {}", root.status);
                color: Theme.text_secondary;
                font-size: Theme.caption_size;
                font-family: Theme.font_family;
                accessible-label: @tr("Anwendungsstatus");
                height: Theme.caption_line_height;
            }

            if (root.progress >= 0) : Text {
                text: @tr("Fortschritt: {}%", root.progress);
                color: Theme.text_secondary;
                font-size: Theme.caption_size;
                font-family: Theme.font_family;
                accessible-label: @tr("Fortschritt des Vorgangs");
                height: Theme.caption_line_height;
            }

            input-field := FluentTextField {
                width: parent.width;
                label: @tr("Wert");
                placeholder: @tr("Wert eingeben");
                value <=> root.input-value;
                agent-id: "main.input";
                agent-role: "textbox";
                agent-actions: "get_value,set_value,focus";
                label-for-accessibility: @tr("Haupteingabe");
                edited(value) => {
                    root.input-changed(value);
                }
            }

            file-picker := FluentButton {
                label: @tr("Datei auswählen");
                agent-id: "main.file-picker";
                agent-role: "button";
                agent-actions: "click,get_value,set_value,focus";
                clicked => {
                    root.pick-file();
                }
            }

            // agent-id: "main.selected-file"
            // agent-role: "status"
            // agent-actions: "get_value"
            // Plain `Text` has no `agent-id` property; this marker keeps the
            // agent-api coverage check in sync with the selected path output.
            Text {
                width: parent.width;
                height: Theme.body_line_height * 2;
                text: root.selected-file == "" ? @tr("Keine Datei ausgewählt") : root.selected-file;
                color: root.selected-file == "" ? Theme.text_secondary : Theme.text_primary;
                font-size: Theme.body_size;
                font-family: Theme.font_family;
                wrap: word-wrap;
                accessible-label: @tr("Ausgewählter Dateipfad");
            }

            HorizontalLayout {
                width: parent.width;
                spacing: Theme.space_3;
                alignment: end;
                height: Theme.control_height;

                reset-button := FluentButton {
                    label: @tr("Zurücksetzen");
                    agent-id: "main.reset";
                    agent-role: "button";
                    agent-actions: "click,focus";
                    clicked => {
                        root.input-value = "";
                        root.reset();
                    }
                }

                submit-button := FluentButton {
                    label: @tr("Senden");
                    primary: true;
                    disabled: !root.submit-enabled;
                    agent-id: "main.submit";
                    agent-role: "button";
                    agent-actions: "click,focus";
                    clicked => {
                        root.submit(root.input-value);
                    }
                }

                cancel-button := FluentButton {
                    label: @tr("Abbrechen");
                    disabled: !root.cancel-enabled;
                    agent-id: "main.cancel";
                    agent-role: "button";
                    agent-actions: "click,focus";
                    clicked => {
                        root.cancel();
                    }
                }
            }
        }
    }
}
