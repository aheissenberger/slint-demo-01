import { Theme } from "../theme/theme.slint";

export component FluentTextField inherits Rectangle {
    in property <string> label: "Beschriftung";
    in-out property <string> value: "";
    in property <string> placeholder: "";
    in property <bool> disabled: false;
    in property <bool> invalid: false;
    in property <string> agent-id: "";
    in property <string> label-for-accessibility: "";
    callback edited(string);

    border-width: Theme.border_width_none;
    background: transparent;
    height: Theme.field_label_height + Theme.space_2 + Theme.field_height;
    min-width: 240px;
    clip: true;

    states [
        focus when input.has-focus : {
            border-color: Theme.focus;
        }
    ]

    VerticalLayout {
        width: root.width;
        height: root.height;
        spacing: Theme.space_2;
        padding-bottom: Theme.space_1;

        Text {
            text: root.label;
            width: root.width;
            color: Theme.text_primary;
            font-size: Theme.body_size;
            font-family: Theme.font_family;
            font-weight: Theme.body_weight;
            height: Theme.field_label_height;
        }

        field := Rectangle {
            width: root.width;
            height: Theme.field_height;
            border-radius: Theme.radius_1;
            border-width: root.invalid ? Theme.focus_border_width : Theme.border_width;
            border-color: root.invalid ? Theme.error : Theme.border;
            background: root.disabled ? Theme.panel_disabled : Theme.panel;
            clip: true;

            input := TextInput {
                text <=> root.value;
                enabled: !root.disabled;
                x: Theme.space_2;
                width: field.width - Theme.space_2 * 2;
                height: field.height;
                vertical-alignment: center;
                color: root.disabled ? Theme.text_disabled : Theme.text_primary;
                font-family: Theme.font_family;
                accessible-role: text-input;
                accessible-label: root.label-for-accessibility != "" ? root.label-for-accessibility : root.label;
                accessible-description: root.invalid ? root.agent-id + ", ungültiger Wert" : root.agent-id;
                edited => { root.edited(input.text); }
            }

            if (root.value == "" && root.placeholder != "") : Text {
                text: root.placeholder;
                color: Theme.text_placeholder;
                font-size: Theme.body_size;
                x: Theme.space_2;
                width: field.width - Theme.space_2 * 2;
                height: field.height;
                font-family: Theme.font_family;
                vertical-alignment: center;
            }

            states [
                focus when input.has-focus : {
                    border-color: Theme.focus_ring;
                    border-width: Theme.focus_border_width;
                }
            ]
        }
    }
}
