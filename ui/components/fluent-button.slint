import { Theme } from "../theme/theme.slint";

export component FluentButton inherits Rectangle {
    in property <string> label: "Button";
    in property <bool> primary: false;
    in property <bool> disabled: false;
    in property <bool> destructive: false;
    in property <string> agent-id: "";
    in property <string> variant: "standard";
    callback clicked;

    border-radius: Theme.radius_1;
    border-width: Theme.border_width;
    height: Theme.control_height;
    min-width: Theme.button_min_width;
    background: disabled ? Theme.panel_disabled : (primary ? Theme.accent : (destructive ? Theme.destructive_surface : Theme.panel));
    border-color: disabled ? Theme.border : (primary ? Theme.accent : Theme.border);
    opacity: disabled ? Theme.disabled_opacity : 1;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.agent-id;

    states [
        pressed when touch-area.pressed : {
            background: primary ? Theme.accent_pressed : (destructive ? Theme.destructive_surface_pressed : Theme.background);
        }
        hover when touch-area.has-hover : {
            background: primary ? Theme.accent_hover : (destructive ? Theme.destructive_surface_hover : Theme.panel_alt);
        }
        focus when focus-scope.has-focus : {
            border-color: Theme.focus_ring;
            border-width: Theme.focus_border_width;
        }
    ]

    focus-scope := FocusScope {
        width: root.width;
        height: root.height;

        touch-area := TouchArea {
            enabled: !disabled;
            clicked => { root.clicked(); }
        }
    }

    HorizontalLayout {
        spacing: Theme.space_2;
        alignment: center;
        padding-left: Theme.space_4;
        padding-right: Theme.space_4;

        Text {
            text: root.label;
            color: disabled ? Theme.text_disabled : (primary || destructive ? Theme.accent_foreground : Theme.text_primary);
            font-size: Theme.body_size;
            font-family: Theme.font_family;
            font-weight: Theme.body_weight;
            vertical-alignment: center;
        }
    }
}
