import { Theme } from "../theme/theme.slint";
import { FluentButton } from "../components/fluent-button.slint";
import { AboutSlint } from "std-widgets.slint";

// German "About" dialog surface. Fulfils the Slint Royalty-free License
// requirement to disclose the use of Slint from the application's top-level
// menu by embedding the `AboutSlint` widget alongside the app's own notice.
export component AboutDialog inherits Rectangle {
    in property <string> app-version: "0.1.0";
    callback close-requested();

    public function focus-close() {
        close-button.focus-control();
    }

    width: Theme.form_content_width + Theme.space_6 * 2;
    height: self.preferred-height;
    border-radius: Theme.radius_2;
    border-width: Theme.border_width;
    border-color: Theme.border;
    background: Theme.panel;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: Theme.dialog_shadow_blur;
    drop-shadow-offset-y: Theme.dialog_shadow_offset_y;
    accessible-role: text;

    focus-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: Theme.space_6;
            spacing: Theme.space_3;
            alignment: start;

            Text {
                text: @tr("Über Slint Agent Desktop");
                color: Theme.text_primary;
                font-size: Theme.title_size;
                font-family: Theme.font_family;
                font-weight: Theme.title_weight;
                height: Theme.title_line_height;
            }

            Text {
                text: @tr("Version {} · entwickelt mit Rust und Slint.", root.app-version);
                color: Theme.text_secondary;
                font-size: Theme.body_size;
                font-family: Theme.font_family;
                wrap: word-wrap;
            }

            Text {
                text: @tr("© 2025 Copilot. Veröffentlicht unter der MIT-Lizenz.");
                color: Theme.text_secondary;
                font-size: Theme.caption_size;
                font-family: Theme.font_family;
                wrap: word-wrap;
            }

            Rectangle {
                height: Theme.border_width;
                background: Theme.border;
            }

            Text {
                text: @tr("Diese Anwendung verwendet das UI-Toolkit Slint (https://slint.dev), lizenziert unter der lizenzgebührenfreien Slint-Lizenz.");
                color: Theme.text_secondary;
                font-size: Theme.caption_size;
                font-family: Theme.font_family;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: center;

                AboutSlint {
                    width: Theme.about_logo_max_width;
                }
            }

            HorizontalLayout {
                alignment: end;
                height: Theme.control_height;

                close-button := FluentButton {
                    label: @tr("Schließen");
                    primary: true;
                    agent-id: "about.close";
                    agent-role: "button";
                    agent-actions: "click";
                    clicked => {
                        root.close-requested();
                    }
                }
            }
        }
    }
}
