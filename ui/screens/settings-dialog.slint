import { FluentButton } from "../components/fluent-button.slint";
import { FluentRadioButton } from "../components/fluent-radio-button.slint";
import { Theme } from "../theme/theme.slint";

export component SettingsDialog inherits Rectangle {
    in-out property <string> theme-mode: "system";
    in property <string> data-summary: "";
    in property <string> last-backup-path: "";
    callback theme-mode-changed(string);
    callback create-data-backup();
    callback reset-user-data();
    callback close-requested();

    function select-theme-mode(mode: string) {
        if (root.theme-mode != mode) {
            root.theme-mode = mode;
            root.theme-mode-changed(mode);
        }
    }

    width: Theme.settings_content_width + Theme.space_6 * 2;
    height: self.preferred-height;
    border-radius: Theme.radius_2;
    border-width: Theme.border_width;
    border-color: Theme.border;
    background: Theme.panel;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: Theme.dialog_shadow_blur;
    drop-shadow-offset-y: Theme.dialog_shadow_offset_y;
    accessible-role: groupbox;
    accessible-label: @tr("Einstellungen");

    VerticalLayout {
        padding: Theme.space_6;
        spacing: Theme.space_4;
        alignment: start;

        Text {
            text: @tr("Einstellungen");
            color: Theme.text_primary;
            font-size: Theme.title_size;
            font-family: Theme.font_family;
            font-weight: Theme.title_weight;
            height: Theme.title_line_height;
        }

        Text {
            text: @tr("Darstellung");
            color: Theme.text_primary;
            font-size: Theme.subtitle_size;
            font-family: Theme.font_family;
            font-weight: Theme.strong_weight;
            height: Theme.subtitle_line_height;
        }

        Text {
            text: @tr("Legen Sie fest, ob die App der Systemeinstellung folgt oder ein festes Design verwendet.");
            color: Theme.text_secondary;
            font-size: Theme.body_size;
            font-family: Theme.font_family;
            height: Theme.body_line_height * 2;
            wrap: word-wrap;
        }

        Rectangle {
            height: self.preferred-height;
            accessible-role: groupbox;
            accessible-label: @tr("App-Design");

            VerticalLayout {
                spacing: Theme.space_2;

                Text {
                    text: @tr("App-Design");
                    color: Theme.text_primary;
                    font-size: Theme.body_size;
                    font-family: Theme.font_family;
                    font-weight: Theme.body_weight;
                    height: Theme.body_line_height;
                }

                FluentRadioButton {
                    width: parent.width;
                    label: @tr("Systemeinstellung verwenden");
                    checked: root.theme-mode == "system";
                    agent-id: "settings.theme.system";
                    agent-role: "radio";
                    agent-actions: "click";
                    selected => {
                        root.select-theme-mode("system");
                    }
                }

                FluentRadioButton {
                    width: parent.width;
                    label: @tr("Hell");
                    checked: root.theme-mode == "light";
                    agent-id: "settings.theme.light";
                    agent-role: "radio";
                    agent-actions: "click";
                    selected => {
                        root.select-theme-mode("light");
                    }
                }

                FluentRadioButton {
                    width: parent.width;
                    label: @tr("Dunkel");
                    checked: root.theme-mode == "dark";
                    agent-id: "settings.theme.dark";
                    agent-role: "radio";
                    agent-actions: "click";
                    selected => {
                        root.select-theme-mode("dark");
                    }
                }
            }
        }

        Text {
            text: @tr("Daten");
            color: Theme.text_primary;
            font-size: Theme.subtitle_size;
            font-family: Theme.font_family;
            font-weight: Theme.strong_weight;
            height: Theme.subtitle_line_height;
        }

        // agent-id: "settings.data.summary"
        // agent-role: "status"
        // agent-actions: "get_value"
        Text {
            width: parent.width;
            text: root.data-summary == "" ? @tr("Datenstatus wird geladen") : root.data-summary;
            color: Theme.text_secondary;
            font-size: Theme.body_size;
            font-family: Theme.font_family;
            height: Theme.body_line_height * 2;
            wrap: word-wrap;
            accessible-label: @tr("Datenstatus");
        }

        // agent-id: "settings.data.backup-path"
        // agent-role: "status"
        // agent-actions: "get_value"
        Text {
            width: parent.width;
            text: root.last-backup-path == "" ? @tr("Noch keine Datensicherung erstellt") : root.last-backup-path;
            color: Theme.text_secondary;
            font-size: Theme.caption_size;
            font-family: Theme.font_family;
            height: Theme.caption_line_height * 2;
            wrap: word-wrap;
            accessible-label: @tr("Letzte Datensicherung");
        }

        HorizontalLayout {
            width: parent.width;
            spacing: Theme.space_3;
            alignment: end;
            height: Theme.control_height;

            FluentButton {
                label: @tr("Daten sichern");
                agent-id: "settings.data.backup";
                agent-role: "button";
                agent-actions: "click";
                clicked => {
                    root.create-data-backup();
                }
            }

            FluentButton {
                label: @tr("Lokale Daten zurücksetzen");
                destructive: true;
                agent-id: "settings.data.reset";
                agent-role: "button";
                agent-actions: "click";
                clicked => {
                    root.reset-user-data();
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            height: Theme.control_height;

            FluentButton {
                label: @tr("Schließen");
                primary: true;
                agent-id: "settings.close";
                agent-role: "button";
                agent-actions: "click";
                clicked => {
                    root.close-requested();
                }
            }
        }
    }
}
