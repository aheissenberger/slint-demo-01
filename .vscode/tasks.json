{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check",
      "type": "shell",
      "command": "./scripts/check",
      "options": { "cwd": "/workspace" },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "./scripts/test",
      "options": { "cwd": "/workspace" },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Run App",
      "type": "shell",
      "command": "./scripts/run",
      "options": { "cwd": "/workspace" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Take Screenshot",
      "type": "shell",
      "command": "./scripts/screenshot",
      "options": { "cwd": "/workspace" },
      "problemMatcher": []
    },
    {
      "label": "Doctor",
      "type": "shell",
      "command": "./scripts/doctor",
      "options": { "cwd": "/workspace" },
      "problemMatcher": []
    },
    {
      "label": "Run E2E",
      "type": "shell",
      "command": "./scripts/e2e",
      "options": { "cwd": "/workspace" },
      "problemMatcher": []
    },
    {
      "label": "cargo check",
      "type": "shell",
      "command": "cargo check --all-targets",
      "options": { "cwd": "/workspace" },
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo test --workspace",
      "options": { "cwd": "/workspace" },
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets --all-features -- -D warnings",
      "options": { "cwd": "/workspace" },
      "problemMatcher": "$rustc"
    }
  ]
}
