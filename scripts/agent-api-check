#!/usr/bin/env python3
"""Cross-check semantic metadata between the Slint UI and crates/agent-api.

The slint-contract helper first compiles the UI entry point with the official
Slint interpreter and emits structured source-level contract JSON. Every UI id,
role, and action set must have a matching agent-api semantic entry. Duplicate
concrete IDs are rejected by the Rust helper before this comparison.

Two kinds of UI declarations are recognized:
  - `agent-id`, `agent-role`, and `agent-actions` properties on reusable
    component instances.
  - matching `// agent-*` comment markers directly above built-ins that cannot
    carry custom properties.
"""

import json
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
UI_DIR = REPO_ROOT / "ui"
AGENT_API_DIR = REPO_ROOT / "crates" / "agent-api" / "src"

RUST_ELEMENT_ID_RE = re.compile(r'\bid:\s*"([^"]+)"\.to_string\(\)')
RUST_ELEMENT_FACTORY_ID_RE = re.compile(r'\belement\(\s*"([^"]+)"')
RUST_ACTION_ID_RE = re.compile(r'action\.id\s*==\s*"([^"]+)"')
RUST_METADATA_RE = re.compile(
    r'\(\s*"([^"]+)"\s*,\s*UiComponentMetadata\s*\{\s*'
    r'role:\s*"([^"]+)"\s*,\s*actions:\s*&\[(.*?)\]\s*,?\s*\}\s*,?\s*\)',
    re.DOTALL,
)
RUST_STRING_RE = re.compile(r'"([^"]+)"')


def find_ids(pattern: re.Pattern, path: Path) -> dict[str, list[tuple[Path, int]]]:
    found: dict[str, list[tuple[Path, int]]] = {}
    source = path.read_text()
    for match in pattern.finditer(source):
        line_no = source.count("\n", 0, match.start()) + 1
        found.setdefault(match.group(1), []).append((path, line_no))
    return found


def merge(*dicts: dict[str, list[tuple[Path, int]]]) -> dict[str, list[tuple[Path, int]]]:
    merged: dict[str, list[tuple[Path, int]]] = {}
    for d in dicts:
        for key, locations in d.items():
            merged.setdefault(key, []).extend(locations)
    return merged


def relative(path: Path) -> str:
    return str(path.relative_to(REPO_ROOT))


def format_locations(locations: list[tuple[Path, int]]) -> str:
    return ", ".join(f"{relative(path)}:{line}" for path, line in locations)

def find_metadata(path: Path) -> dict[str, tuple[str, list[str], tuple[Path, int]]]:
    source = path.read_text()
    found: dict[str, tuple[str, list[str], tuple[Path, int]]] = {}
    for match in RUST_METADATA_RE.finditer(source):
        element_id, role, action_source = match.groups()
        line = source.count("\n", 0, match.start()) + 1
        found[element_id] = (role, RUST_STRING_RE.findall(action_source), (path, line))
    return found


def main() -> int:
    rust_files = sorted(AGENT_API_DIR.rglob("*.rs"))

    if not rust_files:
        print(f"error: no .rs files found under {AGENT_API_DIR}", file=sys.stderr)
        return 2

    contract = subprocess.run(
        ["cargo", "run", "--quiet", "-p", "slint-contract", "--bin", "slint-contract-check", "--", str(UI_DIR)],
        cwd=REPO_ROOT,
        check=False,
        text=True,
        capture_output=True,
    )
    if contract.returncode != 0:
        print(contract.stderr, file=sys.stderr, end="")
        return contract.returncode
    try:
        contract_json = json.loads(contract.stdout)
    except json.JSONDecodeError as error:
        print(f"error: invalid slint-contract JSON: {error}", file=sys.stderr)
        return 2
    ui_elements = {element["id"]: element for element in contract_json["elements"]}
    ui_ids = {
        element_id: [(Path(element["path"]), element["line"])]
        for element_id, element in ui_elements.items()
    }
    element_ids = merge(
        *(find_ids(RUST_ELEMENT_ID_RE, f) for f in rust_files),
        *(find_ids(RUST_ELEMENT_FACTORY_ID_RE, f) for f in rust_files),
    )
    action_ids = merge(*(find_ids(RUST_ACTION_ID_RE, f) for f in rust_files))
    agent_api_ids = merge(element_ids, action_ids)
    rust_metadata: dict[str, tuple[str, list[str], tuple[Path, int]]] = {}
    for rust_file in rust_files:
        rust_metadata.update(find_metadata(rust_file))

    errors: list[str] = []

    for agent_id, locations in sorted(ui_ids.items()):
        if agent_id not in element_ids:
            errors.append(
                f'"{agent_id}" is declared in the UI ({format_locations(locations)}) '
                "but is not exposed by inspect_ui() in crates/agent-api/src/lib.rs"
            )

    for agent_id, locations in sorted(agent_api_ids.items()):
        if agent_id not in ui_ids:
            errors.append(
                f'"{agent_id}" is referenced in agent-api ({format_locations(locations)}) '
                "but no matching `agent-id` (property or `// agent-id:` marker) exists "
                "under ui/ — remove the dead entry or add the UI marker"
            )

    for agent_id, element in sorted(ui_elements.items()):
        metadata = rust_metadata.get(agent_id)
        location = format_locations(ui_ids[agent_id])
        if metadata is None:
            errors.append(
                f'"{agent_id}" at {location} has no UiComponentMetadata entry'
            )
            continue
        role, actions, rust_location = metadata
        if role != element["role"]:
            errors.append(
                f'"{agent_id}" role differs: UI declares "{element["role"]}" at '
                f'{location}, Rust declares "{role}" at {format_locations([rust_location])}'
            )
        if actions != element["actions"]:
            errors.append(
                f'"{agent_id}" actions differ: UI declares {element["actions"]} at '
                f'{location}, Rust declares {actions} at {format_locations([rust_location])}'
            )

    for agent_id, (_, _, location) in sorted(rust_metadata.items()):
        if agent_id not in ui_elements:
            errors.append(
                f'"{agent_id}" metadata at {format_locations([location])} has no '
                "matching Slint declaration"
            )

    if errors:
        print("agent-api coverage check failed:\n", file=sys.stderr)
        for error in errors:
            print(f"  - {error}", file=sys.stderr)
        print(
            f"\n{len(ui_ids)} UI agent-id(s), {len(element_ids)} inspect_ui element(s), "
            f"{len(action_ids)} action handler(s) matched by id.",
            file=sys.stderr,
        )
        return 1

    print(
        f"agent-api coverage check passed: {len(ui_ids)} UI agent-id(s) all have "
        f"matching inspect_ui elements ({len(element_ids)} total), "
        f"{len(action_ids)} action handler(s) all trace to a real UI element, "
        "and role/action metadata matches."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
